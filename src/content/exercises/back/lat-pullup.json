  "muscles": {
    "primary": [
      "Latissimus Dorsi"
    ],
    "secondary": [
      "Biceps",
      "Rear Deltoids"
    ]
  },
  "instructions": [
    "Hang from bar with overhand grip, slightly wider than shoulders.",
    "Start from dead hang with arms fully extended.",
    "Pull body up until chin clears the bar.",
    "Lower with control to dead hang.",
    "Avoid swinging or using momentum."
  ],
  "tips": [
    "Think about pulling elbows down and back",
    "Keep core engaged throughout"
  ],
  "safety": [
    "Don't drop from the top position",
    "Use assistance bands if needed"
  ],
