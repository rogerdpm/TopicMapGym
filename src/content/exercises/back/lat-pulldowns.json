  "instructions": [
    "Sit at the lat pulldown machine and secure thighs under pad.",
    "Grip bar slightly wider than shoulder-width.",
    "Lean back slightly and pull bar down to upper chest.",
    "Squeeze shoulder blades together at the bottom.",
    "Control the weight back up with slight pause."
  ],
  "tips": [
    "Focus on pulling with back muscles, not arms",
    "Keep torso stable throughout"
  ],
  "safety": [
    "Don't lean back excessively",
    "Control the weight on the way up"
  ],
