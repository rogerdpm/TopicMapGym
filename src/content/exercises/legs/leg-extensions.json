  "instructions": [
    "Sit in machine with back against pad.",
    "Position ankles under roller.",
    "Extend legs until straight but not locked.",
    "Squeeze quads at the top.",
    "Lower with control back to start."
  ],
  "tips": [
    "Don't use momentum to lift the weight",
    "Keep core engaged for stability"
  ],
  "safety": [
    "Don't hyperextend the knees",
    "Adjust pad if it presses on ankles"
  ],
