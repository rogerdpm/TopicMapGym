  "instructions": [
    "Stand with feet shoulder-width apart.",
    "Step forward with one leg, lowering until both knees are 90 degrees.",
    "Keep front knee over ankle, don't let it cave.",
    "Push through front heel to return to start.",
    "Alternate legs or complete one side then the other."
  ],
  "tips": [
    "Keep torso upright throughout",
    "Take a big enough step to create 90-degree angles"
  ],
  "safety": [
    "Don't let front knee extend past toes",
    "Maintain balance throughout"
  ],
