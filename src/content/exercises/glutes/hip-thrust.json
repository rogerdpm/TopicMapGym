{
  "name": "Hip Thrust",
  "category": "glutes",
  "difficulty": "beginner",
  "equipment": [
    "Barbell",
    "Bench"
  ],
  "muscles": {
    "primary": [
      "Gluteus Maximus"
    ],
    "secondary": [
      "Hamstrings"
    ]
  },
  "instructions": [
    "Sit on ground with upper back against bench.",
    "Roll barbell over hips, pad with a towel if needed.",
    "Feet flat, shoulder-width apart.",
    "Drive through heels to lift hips until body forms a line.",
    "Squeeze glutes at top, lower with control."
  ],
  "tips": [
    "Keep chin tucked throughout movement",
    "Don't hyperextend lower back at the top"
  ],
  "safety": [
    "Use a towel or pad on barbell for comfort",
    "Don't let knees cave inward"
  ],
