{
  "name": "Bulgarian Split Squats",
  "category": "glutes",
  "difficulty": "intermediate",
  "equipment": [
    "Dumbbells",
    "Bench"
  ],
  "muscles": {
    "primary": [
      "Gluteus Maximus",
      "Quadriceps"
    ],
    "secondary": [
      "Hamstrings",
      "Core"
    ]
  },
  "instructions": [
    "Stand facing away from bench, place one foot on it behind you.",
    "Hold dumbbells at sides, keep torso upright.",
    "Lower until front thigh is parallel to floor.",
    "Push through front heel to return to start.",
    "Complete reps then switch legs."
  ],
  "tips": [
    "Keep front knee tracking over toes",
    "Maintain balance by looking at a fixed point"
  ],
  "safety": [
    "Start without weight to master balance",
    "Ensure bench is stable"
  ],
