  "instructions": [
    "Position yourself on the hack squat machine facing the pad.",
    "Place shoulders under the pads and grip the handles.",
    "Release the safety and lower your body by bending knees.",
    "Keep chest up and back straight throughout the movement.",
    "Push through heels to return to starting position."
  ],
  "tips": [
    "Keep knees tracking over toes",
    "Maintain neutral spine position"
  ],
  "safety": [
    "Don't lock knees at the top",
    "Ensure safety pins are set correctly"
  ],
