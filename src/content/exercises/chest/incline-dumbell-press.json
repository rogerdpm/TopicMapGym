  "instructions": [
    "Set bench to 30-45 degree incline.",
    "Lie back holding dumbbells at chest level.",
    "Press dumbbells up until arms are extended.",
    "Lower with control to chest level.",
    "Maintain slight elbow bend at bottom."
  ],
  "tips": [
    "Keep back flat against the bench",
    "Don't let dumbbells drift too far apart at top"
  ],
  "safety": [
    "Don't bounce the weights off chest",
    "Use a spotter for heavy dumbbells"
  ],
