  },
  "instructions": [
    "Sit with knees bent, feet off floor.",
    "Lean back slightly, keeping back straight.",
    "Hold weight at chest or clasped hands.",
    "Rotate torso to one side, then the other.",
    "Keep core engaged throughout."
  ],
  "tips": [
    "Move with control, don't swing",
    "Exhale as you twist"
  ],
  "safety": [
    "Don't round your back",
    "Start without weight"
  ],
