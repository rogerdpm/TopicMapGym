---
import type { Category } from '../lib/categories';

interface Props {
  category: Category;
}

const { category } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<a
  href={`${base}/${category.id}`}
  class="card card-hover block border-l-4 transition-all duration-150 group"
  style={`border-left-color: ${category.color};`}
>
  <div class="flex items-start gap-4">
    <span class="text-4xl" aria-hidden="true">{category.icon}</span>
    <div class="flex-1">
      <h3 class="text-xl font-semibold mb-1 group-hover:text-primary transition-colors">
        {category.name}
      </h3>
      <p class="text-text-secondary text-sm">{category.description}</p>
    </div>
    <svg
      class="w-5 h-5 text-text-secondary group-hover:text-primary group-hover:translate-x-1 transition-all"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </div>
</a>
