---
import Layout from '../layouts/Layout.astro';
import { categories } from '../lib/categories';
---

<Layout title="Page Not Found" description="The page you're looking for doesn't exist">
  <main class="relative z-10 flex flex-col items-center justify-center min-h-[80vh] px-4 text-center">
    <div class="mb-8">
      <span class="text-9xl font-bold text-primary">404</span>
    </div>
    <h1 class="text-3xl font-bold mb-4">Page Not Found</h1>
    <p class="text-text-secondary mb-8 max-w-md">
      The page you're looking for doesn't exist or has been moved.
    </p>

    <div class="space-y-4">
      <a href="/" class="btn btn-primary inline-flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        Back to Home
      </a>
    </div>

    <div class="mt-12 pt-8 border-t border-surface-light w-full max-w-md">
      <p class="text-text-secondary mb-4">Or browse a category:</p>
      <div class="flex flex-wrap justify-center gap-2">
        {categories.map((cat) => (
          <a
            href={`/${cat.id}`}
            class="px-4 py-2 rounded-lg bg-surface-light hover:bg-surface-lighter transition-colors text-sm"
          >
            {cat.name}
          </a>
        ))}
      </div>
    </div>
  </main>
</Layout>
