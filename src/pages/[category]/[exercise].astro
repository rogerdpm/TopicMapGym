---
import Layout from '../../layouts/Layout.astro';
import { categories, getCategoryById } from '../../lib/categories';
import { getExercisesByCategory, buildMediaUrl } from '../../lib/exercises';
import Badge from '../../components/ui/Badge.astro';
import MediaViewer from '../../components/MediaViewer';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const paths = [];
  for (const category of categories) {
    const exercises = await getExercisesByCategory(category.id);
    for (const exercise of exercises) {
      // Astro content collection id includes folder path, extract just the slug
      const exerciseSlug = exercise.id.split('/').pop();
      paths.push({
        params: { category: category.id, exercise: exerciseSlug },
        props: { exercise },
      });
    }
  }
  return paths;
};

const { category: categoryId, exercise: exerciseId } = Astro.params;
const { exercise } = Astro.props;

if (!exercise) {
  return Astro.redirect('/404');
}

const category = getCategoryById(categoryId!);
const { data } = exercise;

const allMedia = [
  ...data.media.diagrams.map((d, i) => ({ type: 'diagram', src: d, index: i + 1 })),
  ...(data.media.videos || []).map((v, i) => ({ type: 'video', src: v, index: i + 1 })),
];
---

<Layout title={data.name}>
  <header class="relative z-10 px-4 py-6 border-b border-surface-light">
    <div class="max-w-6xl mx-auto">
      <a
        href={`/${category?.id}`}
        class="inline-flex items-center gap-2 text-text-secondary hover:text-primary mb-4 transition-colors"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to {category?.name}
      </a>
    </div>
  </header>

  <main class="relative z-10 px-4 py-8">
    <div class="max-w-6xl mx-auto">
      <!-- Two Column Layout -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
        <!-- Media Panel -->
        <div class="lg:sticky lg:top-4 lg:self-start">
          <MediaViewer
            media={allMedia}
            exerciseName={data.name}
            client:visible
          />
        </div>

        <!-- Details Panel -->
        <div class="space-y-8">
          <!-- Header -->
          <div>
            <h1 class="text-3xl md:text-4xl font-bold mb-4">{data.name}</h1>
            <div class="flex items-center gap-3 flex-wrap">
              <Badge variant={data.category as any} size="md">{category?.name}</Badge>
              <Badge variant={data.difficulty === 'beginner' ? 'success' : data.difficulty === 'intermediate' ? 'warning' : 'danger'}>
                {data.difficulty}
              </Badge>
            </div>
          </div>

          <!-- Equipment -->
          <div>
            <h2 class="text-lg font-semibold mb-3">Equipment</h2>
            <div class="flex flex-wrap gap-2">
              {data.equipment.map((eq) => (
                <Badge variant="default">{eq}</Badge>
              ))}
            </div>
          </div>

          <!-- Muscles -->
          <div>
            <h2 class="text-lg font-semibold mb-3">Target Muscles</h2>
            <div class="space-y-2">
              <div>
                <span class="text-text-secondary text-sm">Primary:</span>
                <div class="flex flex-wrap gap-2 mt-1">
                  {data.muscles.primary.map((m) => (
                    <Badge variant="success">{m}</Badge>
                  ))}
                </div>
              </div>
              {data.muscles.secondary && data.muscles.secondary.length > 0 && (
                <div>
                  <span class="text-text-secondary text-sm">Secondary:</span>
                  <div class="flex flex-wrap gap-2 mt-1">
                    {data.muscles.secondary.map((m) => (
                      <Badge variant="default">{m}</Badge>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </div>

          <!-- Instructions -->
          <div>
            <h2 class="text-lg font-semibold mb-3">Instructions</h2>
            <ol class="space-y-3">
              {data.instructions.map((step, i) => (
                <li class="flex gap-3">
                  <span class="flex-shrink-0 w-6 h-6 rounded-full bg-primary text-white text-sm flex items-center justify-center font-medium">
                    {i + 1}
                  </span>
                  <span class="text-text-secondary pt-0.5">{step}</span>
                </li>
              ))}
            </ol>
          </div>

          <!-- Tips -->
          {data.tips && data.tips.length > 0 && (
            <div>
              <h2 class="text-lg font-semibold mb-3">Tips</h2>
              <ul class="space-y-2">
                {data.tips.map((tip) => (
                  <li class="flex gap-3 text-text-secondary">
                    <span class="text-accent">•</span>
                    {tip}
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- Safety -->
          {data.safety && data.safety.length > 0 && (
            <div>
              <h2 class="text-lg font-semibold mb-3 flex items-center gap-2">
                <span class="text-danger">⚠</span> Safety
              </h2>
              <ul class="space-y-2">
                {data.safety.map((note) => (
                  <li class="flex gap-3 text-text-secondary">
                    <span class="text-danger">•</span>
                    {note}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </div>
  </main>
</Layout>
