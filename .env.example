# Cloudflare R2 Configuration
# Get these from your Cloudflare Dashboard → R2 → Bucket → Settings

# R2 Bucket URL (e.g., https://abc123.r2.dev)
R2_BUCKET_URL=https://your-account.r2.dev

# R2 API Credentials (from Cloudflare → My Profile → API Tokens)
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key

# Optional: Custom domain for R2 (requires Cloudflare proxy)
# R2_CUSTOM_DOMAIN=https://media.yourdomain.com

# Public: Media CDN URL for production (empty = use local assets)
# Set this after uploading media to R2
PUBLIC_MEDIA_CDN_URL=https://your-account.r2.dev
